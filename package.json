{
  "name": "kis2026_base",
  "version": "1.0.6",
  "description": "Block theme base for KIS.",
  "type": "commonjs",
  "author": "Koutarou ISHIKAWA",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stein2nd/kis2026_base.git"
  },
  "homepage": "https://github.com/stein2nd/kis2026_base#readme",
  "bugs": {
    "url": "https://github.com/stein2nd/kis2026_base/issues"
  },
  "keywords": [
    "wordpress",
    "blocktheme"
  ],
  "directories": {
    "doc": "docs"
  },
  "main": "build/index.js",
  "scripts": {
    "version:sync": "node tools/sync-theme-version.mjs",
    "version:check": "node tools/sync-theme-version.mjs --check",
    "prebuild": "npm run version:sync",
    "version": "npm run version:sync",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:ts": "eslint src/**/*.{ts,tsx} --ext .ts,.tsx",
    "lint:ts:fix": "eslint src/**/*.{ts,tsx} --ext .ts,.tsx --fix",
    "lint:scss": "stylelint src/**/*.scss",
    "lint:scss:fix": "stylelint src/**/*.scss --fix",
    "lint:docs": "s2j-docs-linter ./README.md ./CHANGELOG.md ./docs/**/*.md ./docs_mod/**/*.md",
    "build:dev": "FLUSH_DIST=true vite build --mode development",
    "build": "FLUSH_DIST=true vite build --mode production",
    "dist:zip": "npm run build && node tools/dist/make-dist-zip.mjs",
    "dist:zip:ci": "node tools/dist/make-dist-zip.mjs",
    "format": "prettier --write \"src/**/*.{ts,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,scss}\""
  },
  "overrides": {
    "rollup": "^4.64.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@s2j/docs-linter": "^1.0.26",
    "@types/jquery": "^4.0.1",
    "@types/node": "^26.6.4",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "autoprefixer": "^10.6.1",
    "archiver": "^8.0.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "rollup": "^4.64.0",
    "sass": "^1.105.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-static-copy": "^4.1.1"
  },
  "allowScripts": {
    "@s2j/docs-linter": true
  }
}
